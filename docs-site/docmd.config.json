{
  "title": "laravel-ecr17",
  "description": "Italian ECR17 / Protocollo 17 payment protocol over TCP for PHP and Laravel.",
  "url": "https://doc.laravel-ecr17.padosoft.com",
  "src": "docs",
  "out": "_site",
  "base": "/",
  "copyCode": true,
  "pageNavigation": true,
  "minify": true,
  "logo": {
    "light": "assets/favicon.svg",
    "dark": "assets/favicon.svg",
    "alt": "laravel-ecr17"
  },
  "theme": {
    "name": "default",
    "appearance": "system",
    "primaryColor": "#0d9488",
    "customCss": [
      "assets/custom.css"
    ]
  },
  "layout": {
    "spa": true,
    "header": {
      "enabled": true
    },
    "sidebar": {
      "enabled": true,
      "collapsible": true,
      "defaultCollapsed": false
    },
    "footer": {
      "style": "minimal",
      "content": "MIT © padosoft. Documentation for padosoft/laravel-ecr17."
    },
    "menubar": {
      "enabled": true,
      "left": [
        {
          "title": "GitHub",
          "path": "https://github.com/padosoft/laravel-ecr17"
        },
        {
          "title": "Packagist",
          "path": "https://packagist.org/packages/padosoft/laravel-ecr17"
        }
      ],
      "right": [
        {
          "title": "Demo",
          "path": "/guides/demo-debug-console"
        }
      ]
    },
    "optionsMenu": {
      "position": "header",
      "components": {
        "search": true,
        "themeSwitch": true
      }
    }
  },
  "footer": {
    "style": "minimal",
